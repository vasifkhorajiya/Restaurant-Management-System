PORT=5000
NODE_ENV=development

# --- PostgreSQL (use the SAME user/password you use to log in to pgAdmin) -------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=restaurant_management
DB_TIMEZONE=Asia/Kolkata          # day/hour reports use this timezone
# DB_SSL=true                     # needed for hosted databases (Neon, Supabase, Render, RDS…)
# DATABASE_URL=postgres://user:password@host:5432/dbname   # alternative: one connection string (overrides DB_* above)

# --- Security ------------------------------------------------------------------
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
SESSION_HOURS=12
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173 # comma-separated list is allowed
APP_URL=http://localhost:5173     # used in password-reset emails (the address of the website)
# TRUST_PROXY=1                   # when running behind nginx / Render / Railway

# --- First admin (used by `npm run seed`) ---------------------------------------
# Your own Gmail / mobile / a strong password. Leave empty to use the demo login admin@gmail.com / admin@123.
ADMIN_EMAIL=
ADMIN_PHONE=                      # +91 followed by 10 digits, e.g. +919876543211
ADMIN_PASSWORD=                   # 8+ chars with upper, lower and a number

# =============================================================================
#  EMAIL & SMS  (optional)
# =============================================================================
# Used for: order receipts and status emails, "forgot password" links, refund emails, and the
# "order ready" text. Leave empty to stay in DEMO MODE — nothing is sent, and the password-reset
# link is shown on screen instead. Fill in to send real messages.

# ---- Email via Gmail (free) -------------------------------------------------
# 1) Google Account ▸ Security ▸ turn on 2-Step Verification
# 2) Google Account ▸ Security ▸ App passwords ▸ create one named "Spice Route"
# 3) paste the 16-letter password below (spaces are fine)
SMTP_USER=                        # the Gmail that SENDS the emails, e.g. spiceroute.noreply@gmail.com
SMTP_PASS=
EMAIL_FROM_NAME=Spice Route
# SMTP_HOST=smtp.gmail.com        # change only if you use another SMTP provider
# SMTP_PORT=465

# ---- SMS: choose ONE provider -------------------------------------------------
SMS_PROVIDER=                     # twilio  |  fast2sms  |  (empty = demo mode)
# Twilio (works in every country)  https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                      # your Twilio number, e.g. +15005550006   (or use a Messaging Service SID below)
# TWILIO_MESSAGING_SERVICE_SID=
# Fast2SMS (India +91 only)  https://www.fast2sms.com
FAST2SMS_API_KEY=

# Receipts / status updates to the customer's Gmail, and "order ready" SMS (SMS only when a provider is set)
EMAIL_NOTIFICATIONS=true
SMS_ORDER_UPDATES=true

# --- Fake Razorpay (demo gateway built into this project) -----------------------
RAZORPAY_KEY_ID=rzp_test_FAKEKEY00001
RAZORPAY_KEY_SECRET=fake_razorpay_secret_change_me
